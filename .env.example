# GoDaddy API credentials
# Get a key/secret pair at https://developer.godaddy.com/keys
# Use OTE keys for the sandbox environment, production keys for live domains.
GODADDY_API_KEY=your_api_key_here
GODADDY_API_SECRET=your_api_secret_here

# Optional — used by the alert stubs in godaddy_monitor.py
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
# ALERT_FROM=monitor@example.com
# ALERT_TO=ops@example.com
# SMTP_HOST=localhost
